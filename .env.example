# copy to .env.local and fill in. .env.local is gitignored.
#
# this token is ONLY needed for the optional cleanup model push and training
# helpers under models/cleanup/ (scripts/push_to_hub.py, push_code_to_hub.py,
# push_dataset_to_hub.py). it is NEVER needed to build or run Mumble itself, or
# to download the cleanup model at runtime.
#
# HUGGINGFACE_ACCESS_TOKEN must be a write token if you intend to publish to the
# hugging face hub. a read token is enough if you only download from gated hub
# repos. the helpers fall back to HF_TOKEN if HUGGINGFACE_ACCESS_TOKEN is unset.

HUGGINGFACE_ACCESS_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxx
