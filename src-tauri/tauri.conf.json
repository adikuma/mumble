{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mumble",
  "mainBinaryName": "mumble",
  "version": "0.1.0",
  "identifier": "ai.getsolar.mumble",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mumble",
        "width": 1200,
        "height": 900,
        "center": true,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "decorations": false,
        "url": "index.html"
      },
      {
        "label": "indicator",
        "title": "Mumble Indicator",
        "width": 340,
        "height": 80,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "shadow": false,
        "url": "index.html#/indicator"
      }
    ],
    "trayIcon": {
      "id": "mumble-tray",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true,
      "tooltip": "Mumble — hold your hotkey to dictate"
    },
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: https://ipc.localhost https://huggingface.co https://cdn-lfs.huggingface.co; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/onnxruntime.dll"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
